# ============================================================
# Telegram Bot 設定
# ============================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 1. 頻道推播 Chat ID (每日 17:00 定時選股報告發送目標，例如 -1001234567890)
TELEGRAM_CHANNEL_CHAT_ID=-1001234567890

# 2. 個人互動 Chat ID (您個人的 Telegram User ID，用於私訊下指令，例如 123456789)
TELEGRAM_USER_CHAT_ID=

# 3. 兼容舊版設定
TELEGRAM_CHAT_ID=-1001234567890

# ============================================================
# 市場篩選 (listed: 僅看上市 / otc: 僅看上櫃 / all: 全部)
# ============================================================
MARKET=all

# 資料歷史下載長度 (18mo: 1.5年 / 2y: 2年 / 5y: 5年)
DATA_PERIOD=18mo

# ── 篩選條件 ──
MIN_VOLUME=1000
MIN_PRICE=30
MIN_MARKET_CAP=5000000000     # 總市值 > 50 億 TWD
MIN_TURNOVER_TWD=100000       # 成交金額 > 10 萬 TWD
MIN_BETA=1.0                  # 1 年期 Beta > 1.0

# ── 上櫃 (OTC / TPEx) 專屬篩選門檻 ──
MIN_VOLUME_OTC=300
MIN_PRICE_OTC=20
MIN_MARKET_CAP_OTC=1500000000   # 總市值 > 15 億 TWD
MIN_TURNOVER_TWD_OTC=100000     # 成交金額 > 10 萬 TWD
MIN_BETA_OTC=1.0                # Beta > 1.0 (vs TPEx)

# ── 大盤基準指數 ──
BENCHMARK_LISTED=^TWII
BENCHMARK_OTC=006201.TWO

ENABLE_MARKET_CAP_FILTER=true
ENABLE_TURNOVER_FILTER=true
ENABLE_BETA_FILTER=true
EXCLUDE_ETF=true
EXCLUDE_KY=true
EXCLUDE_TDR=true

# Trend Template 門檻
TREND_TEMPLATE_MIN_PASS=6

# VCP 波動收斂設定 (模式: standard 標準 / loose 寬鬆 / strict 嚴格)
VCP_SCAN_MODE=standard
INCLUDE_RECENT_BREAKOUT=true  # 納入 1~3 日內剛突破 (0~8%) 之個股
INCLUDE_PIVOT_RETEST=true     # 納入回踩樞紐有守之個股
VCP_STRICT_MODE=false
VCP_STRICT_CONVERGENCE=true   # 嚴格要求逐波振幅收窄 (T1 > T2 > T3) 與底底高
VCP_MAX_TIGHTNESS=12.0        # 最後一段振幅容許至 12% (寬鬆模式自動放寬至 15%)
VCP_MAX_PIVOT_DISTANCE=8.0   # 距離突破點 8% 內 (寬鬆模式自動放寬至 10%)
VCP_MAX_BASE_DEPTH=45.0       # 底部最大回檔容許 45%

# 排程設定
SCAN_HOUR=17
SCAN_MINUTE=0
TIMEZONE=Asia/Taipei
